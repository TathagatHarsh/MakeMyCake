// Persistence only. The catalogue and the pricing engine live in lib/, not here:
// lib/catalog.ts is what the UI renders and lib/pricing.ts is the authority on
// money, and both are imported identically by the browser, the server and the
// CLI. A CatalogItem table used to mirror them and was never read by a single
// line of application code, so it was removed rather than left to drift.
//
// What the database holds is what cannot be recomputed: saved designs, and
// orders with their price lines frozen at the moment they were agreed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  draft
  confirmed
  in_kitchen
  out_for_delivery
  delivered
  cancelled
}

enum PaymentStatus {
  none
  pending
  paid
  refunded
  failed
}

model Design {
  id        String   @id @default(cuid())
  /// Short, unambiguous slug used by /d/[slug].
  slug      String   @unique
  config    Json
  /// Cached so the gallery does not have to reprice on every render.
  totalPaise Int
  views     Int      @default(0)
  createdAt DateTime @default(now())

  orders    Order[]

  @@index([createdAt])
}

model Order {
  id             String        @id @default(cuid())
  /// Human-facing reference, e.g. MC-4471.
  ref            String        @unique

  config         Json
  priceBreakdown Json
  totalPaise     Int

  status         OrderStatus   @default(draft)

  /// Hook for auth later. Deliberately nullable — v1 has no login.
  userId         String?
  /// Hook for Razorpay later. Deliberately defaults to none — v1 takes no money.
  paymentStatus  PaymentStatus @default(none)
  payablePaise   Int

  customerName   String?
  customerPhone  String?
  pincode        String?
  deliverySlot   String
  leadHours      Int

  allergens      String[]
  servesMin      Int
  servesMax      Int

  designId       String?
  design         Design?       @relation(fields: [designId], references: [id])

  items          OrderItem[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

/// One priced line on the docket, frozen at order time so a later catalog edit
/// cannot rewrite history.
model OrderItem {
  id        String  @id @default(cuid())

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  label     String
  kind      String
  amountPaise Int
  position  Int

  @@index([orderId])
}
